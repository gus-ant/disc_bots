# Token do Bot do Discord (Obtido no Discord Developer Portal)
DISCORD_TOKEN=seu_token_aqui

# ID da Aplicação (Client ID)
CLIENT_ID=seu_client_id_aqui

# ID do Servidor (Guild ID) - Opcional para registro instantâneo de comandos de teste
GUILD_ID=seu_guild_id_aqui

# ID do Canal onde os Standups/Dailies serão publicados
DAILY_CHANNEL_ID=seu_canal_daily_id_aqui

# ID do Canal onde o resumo semanal será publicado toda sexta-feira às 15h
WEEKLY_SUMMARY_CHANNEL_ID=seu_canal_resumo_id_aqui

# ID do Canal onde os registros de acervo/arquivos serão publicados
ARCHIVE_CHANNEL_ID=seu_canal_arquivo_id_aqui

# IDs dos usuários que podem se cadastrar como Admin (separados por vírgula)
ADMIN_USER_IDS=seu_id_discord,gustavo_id_discord
